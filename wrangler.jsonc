{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildrbank",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BuildrBank",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "BuildrBank" }]
  },
  "exports": {
    "BuildrBank": { "type": "durable-object", "storage": "sqlite" }
  }
}
